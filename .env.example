# Copia a .env (raíz) para la API y a apps/web/.env.local para la web. NUNCA subas .env al repositorio.
# Los valores vacíos son seguros para desarrollo local.

# ── API (apps/api) ──
APP_ENV=local                     # local | test | staging | production
DATABASE_URL=                     # vacío en local → Postgres embebido en ~/.modo-english/pgdata
AUTH_MODE=local                   # local (solo APP_ENV=local/test) | supabase
LOCAL_JWT_SECRET=                 # opcional en local; jamás se usa fuera de local
SUPABASE_URL=                     # requerido con AUTH_MODE=supabase (valida JWT vía JWKS)
CORS_ORIGINS=["http://localhost:3000"]

# ── Web (apps/web/.env.local) ──
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=LANIA  # nombre temporal de MVP (ADR-009), cambia aquí

# ── IA (tutor y escritura). Sin proveedor: el tutor aparece «no disponible» (no se simula). ──
LLM_PROVIDER=none                 # none | openai_compatible   (fake solo existe en APP_ENV=test)
LLM_BASE_URL=                     # OpenAI: https://api.openai.com/v1 · Ollama local: http://localhost:11434/v1
LLM_API_KEY=                      # servidor solamente; vacío para Ollama
LLM_FAST_MODEL=                   # ID real del proveedor (tutor), p. ej. gemma3:12b en Ollama
LLM_DEEP_MODEL=                   # ID real del proveedor (corrección de escritura)
LLM_TIMEOUT_SECONDS=90
LLM_FAST_PRICE_IN_PER_MTOK=       # USD/millón de tokens, de la página oficial con fecha; vacío = costo desconocido
LLM_FAST_PRICE_OUT_PER_MTOK=
LLM_DEEP_PRICE_IN_PER_MTOK=
LLM_DEEP_PRICE_OUT_PER_MTOK=
MONTHLY_AI_SPEND_LIMIT_USD=
TUTOR_DAILY_MESSAGE_LIMIT=80

WRITING_DAILY_EVAL_LIMIT=20        # textos corregidos por persona y día (Writing Lab)
SPEAKING_DAILY_TURN_LIMIT=60       # turnos de conversación por persona y día (Speaking Lab)
RATE_LIMIT_PER_MINUTE=120          # peticiones por persona y minuto (0 = sin límite)

# ── Voz (Speaking/Listening). Mismo proveedor y clave que LLM_*. Vacío = voz del navegador + responder escribiendo.
STT_MODEL=                        # p. ej. gpt-transcribe (verificado 2026-11-13)
STT_PRICE_PER_MINUTE_USD=         # gpt-transcribe: 0.0045 (página del modelo, 2026-11-13)
TTS_MODEL=                        # p. ej. gpt-4o-mini-tts — OpenAI lo APAGA el 2027-01-06: migrar antes
TTS_VOICE_LANIA=marin
TTS_PRICE_PER_MILLION_CHARS_USD=  # vacío = costo desconocido (OpenAI cobra por tokens de audio, no por caracteres)
ROOMS_ENABLED=false               # Salones: base preparada, apagada en el piloto

# ── Web: login real con Supabase (vacío = acceso local de desarrollo) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_CONTACT_EMAIL=        # aparece en /privacidad; vacío = solo el botón «¿Algo no funcionó?»
